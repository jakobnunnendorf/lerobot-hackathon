# Per-machine robot settings. Copy to ~/.so101.env on the machine that drives the arm and edit.
# Values below are the robot laptop as set up on 2026-11-20 (Ubuntu 24.04 in WSL2, conda env "lerobot").

# Python environment that has lerobot==0.7.0. Leave empty to use the repo's uv .venv.
SO101_ACTIVATE='source ~/miniforge3/etc/profile.d/conda.sh && conda activate lerobot'

# Stable names come from udev rules on the USB serial number (see the skill); plain /dev/ttyACM* swap on replug.
SO101_FOLLOWER_PORT=/dev/so101_follower
SO101_LEADER_PORT=/dev/so101_leader
# The ids select the calibration files; the demo machine must use the same ones.
SO101_FOLLOWER_ID=mi_follower
SO101_LEADER_ID=mi_leader

# /dev/v4l/by-id paths survive replugging; /dev/videoN numbers do not.
SO101_CAM_TOP=/dev/v4l/by-id/usb-BSW-V06-200512_Integrated_Camera-video-index0
SO101_CAM_WRIST=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB2.0_CAM1_USB2.0_CAM1-video-index0

SO101_HF_USER=molnrb
